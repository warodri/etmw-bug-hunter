# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3032
HOST=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4302,http://127.0.0.1:4302
TRUST_PROXY_HOPS=0

# MongoDB Atlas connection string (source of truth: /Volumes/MACMINI-HD/ETMW/MY-ENV-FILE)
MONGODB_URI=
MONGODB_DATABASE=etmw_bug_hunter

# Scanner limits
BUG_HUNTER_MAX_FILE_BYTES=524288
BUG_HUNTER_MAX_FILES=20000
BUG_HUNTER_SCAN_CONCURRENCY=1

# Default Ollama endpoint shown in Settings (models are never pulled or copied).
BUG_HUNTER_OLLAMA_URL=https://ollama--warodri.entertomyworld.com/

# Sessions. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Optional; defaults to JWT_SECRET. Rotating it revokes every installed desktop agent.
BUG_HUNTER_AGENT_SECRET=
AUTH_SESSION_DAYS=30
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_RATE_EMAIL_MAX=5
AUTH_CODE_RATE_IP_MAX=15
AUTH_CODE_RATE_WINDOW_MINUTES=10
# Comma-separated allowlist. Empty means any valid email may sign in.
AUTH_ALLOWED_EMAILS=
# When set, this email adopts data created before accounts existed.
OWNER_EMAIL=

# Login codes. The server refuses to send codes in production without these.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_NAME=ETMW Bug Hunter
EMAIL_FROM_ADDRESS=

# Desktop agent download and pairing
BUG_HUNTER_PUBLIC_URL=http://localhost:4302/
BUG_HUNTER_AGENT_WS_URL=ws://127.0.0.1:3032/agent
# Folder containing the agent source and installers (the download endpoint zips it).
BUG_HUNTER_AGENT_DIR=../CLIENT/DESKTOP
